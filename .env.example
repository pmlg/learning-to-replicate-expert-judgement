# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real tokens/keys.

# HuggingFace Hub token. Raises API rate limits and speeds up dataset
# downloads (qwen_chess_rl.data.download). Get one at:
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Weights & Biases API key for experiment tracking (optional).
# https://wandb.ai/authorize
WANDB_API_KEY=

# GPU device IDs exposed to training/inference (optional).
CUDA_VISIBLE_DEVICES=0

# Stockfish binary location, used for evaluation (optional).
STOCKFISH_PATH=stockfish

# Model checkpoint path served by the web app.
# Use a trained LoRA dir, e.g. checkpoints/sft/final or checkpoints/rl/final
QWEN_CHESS_CHECKPOINT=checkpoints/sft/final

# OpenMP threads for data loading (optional).
OMP_NUM_THREADS=8
